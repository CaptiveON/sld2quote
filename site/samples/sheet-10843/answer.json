 "spec": {
  "clauses": [
   {
    "id": "7.1",
    "text": "The switchboard shall be designed, manufactured and verified in accordance with BS EN IEC 61439-2:2021."
   },
   {
    "id": "7.2",
    "text": "Internal separation shall be Form 3b as defined in the UK National Annex."
   },
   {
    "id": "7.3",
    "text": "The assembly shall withstand a prospective short-circuit current of 65 kA for 1 second at the main busbars."
   },
   {
    "id": "7.4",
    "text": "Outgoing moulded-case circuit breakers shall be 4-pole with adjustable thermal-magnetic or electronic trip units."
   },
   {
    "id": "7.5",
    "text": "Degree of protection shall be not less than IP42 with doors closed."
   },
   {
    "id": "7.6",
    "text": "Main busbars shall be hard-drawn high-conductivity copper, tin-plated at joints."
   },
   {
    "id": "7.7",
    "text": "The contractor shall provide type-test or design-verification certificates prior to manufacture."
   },
   {
    "id": "7.8",
    "text": "Witness testing at the manufacturer's works shall be allowed for."
   }
  ],
  "requirements": {
   "standard": "BS EN IEC 61439-2:2021",
   "form": "Form 3b",
   "fault_kA": 65,
   "poles": 4,
   "ip": "IP42",
   "busbar_material": "copper",
   "certificates": true,
   "extra": "Witness testing at the manufacturer's works shall be allowed for."
  }
